---
// The unsquare brandmark as inline SVG. Color comes from `color` (currentColor).
import { marks, markViewBox, type MarkWeight } from '../data/brand';

interface Props {
  weight?: MarkWeight;
  class?: string;
  /** Accessible name. Without it, the mark is decoration (aria-hidden). */
  label?: string;
}
const { weight = 'fat', class: cls, label } = Astro.props;
---
<svg class:list={['mark', cls]} viewBox={markViewBox} fill="currentColor" fill-rule="evenodd"
  role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false"><path d={marks[weight]} /></svg>
