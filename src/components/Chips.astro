---
import { getSkill, type SkillId } from '../data/skills';
import { skillUrl } from '../lib/url';

interface Props { skills: readonly SkillId[] }
const { skills } = Astro.props;
---
{skills.length > 0 && (
  <ul class="tags" aria-label="Skills">
    {skills.map((id) => <li><a href={skillUrl(id)}>{getSkill(id).name}</a></li>)}
  </ul>
)}
