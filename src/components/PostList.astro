---
import Chips from './Chips.astro';
import type { Post } from '../lib/content';
import { formatDate, isoDate } from '../lib/format';
import { postUrl } from '../lib/url';

interface Props {
  posts: Post[];
  /** Blog index: h2 titles and skill links. */
  big?: boolean;
}
const { posts, big = false } = Astro.props;
const Heading = big ? 'h2' : 'h3';
---
<ol class="rows" role="list">
  {posts.map((post) => (
    <li class="row">
      <div class="when"><span class="period"><time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time></span></div>
      <div class="what">
        <Heading><a class="post-link" href={postUrl(post.id)}>{post.data.title}</a></Heading>
        <p>{post.data.description}</p>
        {big && <Chips skills={post.data.skills} />}
      </div>
    </li>
  ))}
</ol>
