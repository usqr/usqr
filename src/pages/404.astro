---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Not found">
  <div class="wrap has-corner">
    <header class="grid page-head">
      <div class="span-label"><p class="kicker"><span class="usq" aria-hidden="true"></span>404</p></div>
      <div class="span-body"><h1 class="page-title">This page is not here</h1><p class="lede">Maybe the link is old. Maybe it was a typo. The rest of the site is still square. Almost.</p></div>
    </header>
    <section class="grid section" id="go" aria-labelledby="go-h">
      <div class="span-label label"><span class="num">→</span><h2 id="go-h">Where to next</h2></div>
      <div class="span-body"><ul class="go-links" role="list">
        <li><a href={u('/')}>Go to the CV</a></li>
        <li><a href={u('/blog/')}>Go to the Blog</a></li>
        <li><a href={u('/skills/')}>See all skills</a></li>
      </ul></div>
    </section>
  </div>
</Base>
