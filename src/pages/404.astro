---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Not found">
  <div class="wrap">
    <header class="page-head mgrid">
      <p class="kicker m"><span class="usq" aria-hidden="true"></span>404</p>
      <div><h1>This page is not here</h1><p class="lede">Maybe the link is old. Maybe it was a typo. The rest of the site is still square. Almost.</p></div>
    </header>
    <section class="sec mgrid" id="go" aria-labelledby="go-h">
      <div class="sec-head sub"><span class="num m" aria-hidden="true">→</span><h2 id="go-h">Where to next</h2></div>
      <ul class="go-links" role="list">
        <li><a href={u('/')}>Go to the CV</a></li>
        <li><a href={u('/blog/')}>Go to the Blog</a></li>
        <li><a href={u('/skills/')}>See all skills</a></li>
      </ul>
    </section>
  </div>
</Base>
