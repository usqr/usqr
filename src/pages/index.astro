---
import Base from '../layouts/Base.astro';
import Chips from '../components/Chips.astro';
import PostList from '../components/PostList.astro';
import RoleWhen from '../components/RoleWhen.astro';
import { profile } from '../data/profile';
import { areas } from '../data/skills';
import { getEducation, getPosts, getRoles } from '../lib/content';
import { u } from '../lib/url';
import { CV_PDF } from '../../scripts/cv-pdf-render.mjs';

const [roles, education, posts] = await Promise.all([getRoles(), getEducation(), getPosts()]);
const latest = posts.slice(0, 3);
const areaLink: Record<string, string> = { frontend: 'Frontend skills', ux: 'UX skills', ds: 'Design-system skills' };
---
<Base current="cv" bodyClass="d2">
  <section class="hero-d2 lattice" aria-labelledby="name">
    <div class="band" aria-hidden="true"><span>Curriculum vitae</span></div>
    <div class="wrap cgrid">
      <p class="kicker"><span class="usq" aria-hidden="true"></span>Hybrid profile</p>
      <h1 class="name" id="name"><span class="light">{profile.firstName}</span> <span class="bold">{profile.lastName}</span></h1>
      <p class="hybrid">{profile.hybrid.join(' · ')}</p>
      <p class="standfirst">{profile.statement}</p>
      <ul class="proof">
        <li><a href={u(`/${CV_PDF}`)} download>CV as PDF</a></li>
        {profile.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </section>

  <div class="wrap">
    <section class="sec cgrid" id="what" aria-labelledby="what-h">
      <div class="sec-label"><span class="num" aria-hidden="true">01</span><h2 id="what-h">What I do</h2></div>
      <div class="sec-body">
        <ul class="areas">
          {areas.map((area) => (
            <li id={`area-${area.id}`}>
              <h3><span class="usq" aria-hidden="true"></span>{area.name}</h3>
              <p>{area.statement}</p>
              <a href={u(`/skills/#${area.id}`)}>{areaLink[area.id]} →</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="sec cgrid" id="experience" aria-labelledby="exp-h">
      <div class="sec-label"><span class="num" aria-hidden="true">02</span><h2 id="exp-h">Experience</h2></div>
      <div class="sec-body">
        <ol class="rows" role="list">
          {roles.map(({ id, data }) => (
            <li class="row" id={`role-${id}`}>
              <div class="when">
                <span class="year" aria-hidden="true">{data.start.slice(0, 4)}</span>
                <RoleWhen start={data.start} end={data.end} />
                <span class="org">{data.note ? `${data.org} · ${data.note}` : data.org}</span>
              </div>
              <div class="what">
                <h3>{data.title}</h3>
                {data.highlights.length > 0 && <ul class="hl">{data.highlights.map((h) => <li>{h}</li>)}</ul>}
                <Chips skills={data.skills} />
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="sec cgrid" id="education" aria-labelledby="edu-h">
      <div class="sec-label"><span class="num" aria-hidden="true">03</span><h2 id="edu-h">Education</h2></div>
      <div class="sec-body">
        <ol class="rows" role="list">
          {education.map(({ data }) => (
            <li class="row">
              <div class="when">
                <span class="year" aria-hidden="true">{data.start}</span>
                <span class="period"><time datetime={String(data.start)}>{data.start}</time> – <time datetime={String(data.end)}>{data.end}</time></span>
              </div>
              <div class="what"><h3>{data.program}</h3><span class="org">{data.school}</span></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="sec cgrid" id="languages" aria-labelledby="lang-h">
      <div class="sec-label"><span class="num" aria-hidden="true">04</span><h2 id="lang-h">Languages</h2></div>
      <div class="sec-body">
        <dl class="langs">
          {profile.languages.map((l) => <div><dt>{l.name}</dt><dd>{l.level}</dd></div>)}
        </dl>
      </div>
    </section>

    {latest.length > 0 && (
      <section class="sec cgrid" id="posts" aria-labelledby="posts-h">
        <div class="sec-label"><span class="num" aria-hidden="true">05</span><h2 id="posts-h">Latest posts</h2></div>
        <div class="sec-body">
          <PostList posts={latest} />
          <p class="more-row"><a class="more" href={u('/blog/')}>All posts →</a></p>
        </div>
      </section>
    )}
  </div>
</Base>
