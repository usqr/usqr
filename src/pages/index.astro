---
import Base from '../layouts/Base.astro';
import Chips from '../components/Chips.astro';
import Corner from '../components/Corner.astro';
import PostList from '../components/PostList.astro';
import RoleWhen from '../components/RoleWhen.astro';
import { profile } from '../data/profile';
import { areas } from '../data/skills';
import { getEducation, getPosts, getRoles } from '../lib/content';
import { u } from '../lib/url';

const [roles, education, posts] = await Promise.all([getRoles(), getEducation(), getPosts()]);
const latest = posts.slice(0, 3);
const areaLink: Record<string, string> = { frontend: 'Frontend skills', ux: 'UX skills', ds: 'Design-system skills' };
---
<Base current="cv">
  <section class="hero lattice has-corner" aria-labelledby="name">
    <Corner label="Curriculum vitae" />
    <div class="wrap"><div class="hero-panel">
      <h1 class="name" id="name"><span class="light">{profile.firstName}</span> <span class="bold">{profile.lastName}</span></h1>
      <div class="grid hero-grid">
        <div class="span-label">
          <p class="kicker"><span class="usq" aria-hidden="true"></span>Hybrid profile</p>
          <p class="hybrid">{profile.hybrid.map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>
        </div>
        <div class="span-body">
          <p class="statement">{profile.statement}</p>
          <ul class="hero-links">
            <li><a href="#what">What I do</a></li>
            <li><a href={u('/cv.pdf')}>Download PDF</a></li>
            {profile.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
          <p class="print-only sheet-contact">{profile.links.map((l) => <><a href={l.href}>{l.label}</a> </>)}</p>
        </div>
      </div>
    </div></div>
  </section>

  <div class="wrap">
    <section class="grid section" id="what" aria-labelledby="what-h">
      <div class="span-label label"><span class="num">01</span><h2 id="what-h">What I do</h2></div>
      <ul class="span-body areas">
        {areas.map((area) => (
          <li id={`area-${area.id}`}>
            <h3><span class="usq" aria-hidden="true"></span>{area.name}</h3>
            <p>{area.statement}</p>
            <a href={u(`/skills/#${area.id}`)}>{areaLink[area.id]} →</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="grid section" id="experience" aria-labelledby="exp-h">
      <div class="span-label label"><span class="num">02</span><h2 id="exp-h">Experience</h2></div>
      <ol class="span-body rows" role="list">
        {roles.map(({ id, data }) => (
          <li class="row" id={`role-${id}`}>
            <RoleWhen start={data.start} end={data.end} />
            <div>
              <h3>{data.title}</h3>
              <span class="org">{data.note ? `${data.org} · ${data.note}` : data.org}</span>
              {data.highlights.length > 0 && <ul class="hl">{data.highlights.map((h) => <li>{h}</li>)}</ul>}
              <Chips skills={data.skills} />
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="grid section" id="education" aria-labelledby="edu-h">
      <div class="span-label label"><span class="num">03</span><h2 id="edu-h">Education</h2></div>
      <ol class="span-body rows" role="list">
        {education.map(({ data }) => (
          <li class="row"><span class="when">{data.start} – {data.end}</span><div><h3>{data.program}</h3><span class="org">{data.school}</span></div></li>
        ))}
      </ol>
    </section>

    <section class="grid section" id="languages" aria-labelledby="lang-h">
      <div class="span-label label"><span class="num">04</span><h2 id="lang-h">Languages</h2></div>
      <dl class="span-body langs">
        {profile.languages.map((l) => <div><dt>{l.name}</dt><dd>{l.level}</dd></div>)}
      </dl>
    </section>

    {latest.length > 0 && (
      <section class="grid section" id="posts" aria-labelledby="posts-h">
        <div class="span-label">
          <div class="label"><span class="num">05</span><h2 id="posts-h">Latest posts</h2></div>
          <span class="label-sub"><a href={u('/blog/')}>All posts →</a></span>
        </div>
        <PostList posts={latest} class="span-body" />
      </section>
    )}
  </div>
</Base>
