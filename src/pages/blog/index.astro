---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/content';
import { countLabel } from '../../lib/format';
import { u } from '../../lib/url';

const posts = await getPosts();
---
<Base title="Blog" current="blog" description="Notes on frontend, UX, and design systems.">
  <div class="wrap">
    <header class="page-head mgrid">
      <div class="m"><p class="kicker"><span class="usq" aria-hidden="true"></span>Blog</p>{posts.length > 0 && <p class="count">{countLabel(posts.length, 'post')}</p>}</div>
      <div>
        <h1>Notes on frontend, UX, and design systems</h1>
        <p class="lede">Each post is proof for the skills in its links. <a href={u('/rss.xml')}>Follow with RSS</a>.</p>
      </div>
    </header>
    <section class="sec mgrid" aria-label="Posts">
      {posts.length > 0
        ? <PostList posts={posts} big />
        : <p class="empty">First posts are on the way. <a href={u('/rss.xml')}>Follow with RSS</a> to see the first one.</p>}
    </section>
  </div>
</Base>
