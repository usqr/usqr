---
import '../styles/tokens.css';
import '../styles/site.css';
import lato400 from '../styles/fonts/lato-400.woff2?url';
import slab from '../styles/fonts/bitter-var.woff2?url';
import Brandmark from '../components/Brandmark.astro';
import { fullName, profile } from '../data/profile';
import { u } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  current?: 'cv' | 'blog' | 'sidequests' | 'colophon';
  /** d2 = CV page (√2 type scale), cvp = print CV page. */
  bodyClass?: string;
  mainClass?: string;
}

const { title, description = profile.statement, current, bodyClass, mainClass } = Astro.props;
const pageTitle = title ? `${title} — ${fullName}` : `${fullName} — Frontend, UX, design systems`;
const nav = [
  { id: 'cv', label: 'CV', href: u('/') },
  { id: 'blog', label: 'Blog', href: u('/blog/') },
  { id: 'sidequests', label: 'Sidequests', href: u('/sidequests/') },
  { id: 'colophon', label: 'Colophon', href: u('/colophon/') },
] as const;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Cookie-free count: count.js (sends the referrer), image fallback without JS. Set PUBLIC_GOATCOUNTER to turn it on.
const goatcounter = import.meta.env.PUBLIC_GOATCOUNTER;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{pageTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="icon" href={u('/favicon.svg')} type="image/svg+xml">
<link rel="apple-touch-icon" href={u('/apple-touch-icon.png')}>
<meta property="og:type" content="website">
<meta property="og:site_name" content={fullName}>
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={new URL(u('/og.png'), Astro.site)}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={`${fullName}: frontend, UX, design systems`}>
<meta name="twitter:card" content="summary_large_image">
<link rel="alternate" type="application/rss+xml" title={`${fullName} — Blog`} href={u('/rss.xml')}>
<link rel="sitemap" href={u('/sitemap-index.xml')}>
<link rel="preload" href={lato400} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={slab} as="font" type="font/woff2" crossorigin>
{goatcounter && <script is:inline async data-goatcounter={`https://${goatcounter}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>}
<script is:inline data-theme-init>
// Apply the saved theme before the first paint. Without a saved theme, CSS follows prefers-color-scheme.
try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
</script>
<slot name="head" />
</head>
<body class={bodyClass}>
<a class="skip" href="#main">Skip to content</a>
{goatcounter && (
  <noscript><img class="gc" src={`https://${goatcounter}.goatcounter.com/count?p=${encodeURIComponent(Astro.url.pathname)}`} alt="" width="1" height="1"></noscript>
)}
<header class="site-head">
  <div class="wrap head-row">
    <a class="brand" href={u('/')}><Brandmark weight="fat" class="brand-mark" /><span class="light">{profile.firstName}</span> <span class="bold">{profile.lastName}</span></a>
    <button class="theme-switch" type="button" role="switch" aria-checked="false" aria-label="Dark theme" hidden data-theme-switch><span class="theme-knob" aria-hidden="true"></span></button>
    <nav aria-label="Main">
      <ul class="nav">
        {nav.map((item) => (
          <li><a href={item.href} aria-current={item.id === current ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
<main id="main" class={mainClass}>
  <slot />
</main>
<footer class="site-foot lattice">
  <div class="wrap">
    <p class="call">Hiring for a hybrid role? Let’s talk.</p>
    <ul class="foot-links">
      {profile.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><a href={u('/cv/')}>Print CV</a></li>
      <li><a href={u('/rss.xml')}>RSS</a></li>
      <li><a href={u('/colophon/')}>Colophon</a></li>
    </ul>
    <p class="foot-meta">© {year} {fullName} · Static HTML and CSS. No cookies.</p>
  </div>
</footer>
<script is:inline data-print-shortcut define:vars={{ cv: u('/cv/') }}>
// Progressive enhancement: Cmd/Ctrl+P opens the print CV and its print dialog. Without JS, the browser prints the current page.
if (location.pathname !== cv) {
  addEventListener('keydown', (e) => {
    if (!(e.metaKey || e.ctrlKey) || e.altKey || e.shiftKey || e.key.toLowerCase() !== 'p') return;
    e.preventDefault();
    location.href = cv + '#print';
  });
} else if (location.hash === '#print') {
  history.replaceState(null, '', cv);
  addEventListener('load', () => document.fonts.ready.then(() => print()));
}
</script>
<script is:inline data-theme-script>
// Progressive enhancement: the switch shows only with JS. Its start position is the current theme (saved or system).
// A choice equal to the system theme clears the saved value, so the page follows the system again.
(() => {
  const btn = document.querySelector('[data-theme-switch]');
  if (!btn) return;
  const root = document.documentElement;
  const mq = matchMedia('(prefers-color-scheme: dark)');
  const system = () => (mq.matches ? 'dark' : 'light');
  const current = () => root.dataset.theme ?? system();
  const save = (t) => { try { t ? localStorage.setItem('theme', t) : localStorage.removeItem('theme'); } catch {} };
  const sync = () => btn.setAttribute('aria-checked', String(current() === 'dark'));
  btn.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    if (next === system()) { delete root.dataset.theme; save(null); } else { root.dataset.theme = next; save(next); }
    sync();
  });
  mq.addEventListener('change', sync);
  sync();
  btn.hidden = false;
})();
</script>
</body>
</html>
